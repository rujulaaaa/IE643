\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Latent diffusion \citep  {rombach2022ldm}, the base of AnimateDiff. Training adds noise to the VAE latent $z_0$ (Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:forward}\unskip \@@italiccorr )}}) and trains the U-Net to predict it (Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:eps_loss}\unskip \@@italiccorr )}}). Sampling starts from noise $z_T$ and applies the U-Net, conditioned on the CLIP text embedding $c$, for $T$ DDIM steps before the VAE decodes the result.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:ldm}{{2}{4}{Latent diffusion \citep {rombach2022ldm}, the base of AnimateDiff. Training adds noise to the VAE latent $z_0$ (Eq.~\eqref {eq:forward}) and trains the U-Net to predict it (Eq.~\eqref {eq:eps_loss}). Sampling starts from noise $z_T$ and applies the U-Net, conditioned on the CLIP text embedding $c$, for $T$ DDIM steps before the VAE decodes the result.\relax }{figure.caption.2}{}}
