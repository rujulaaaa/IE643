\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces AnimateDiff \citep  {guo2024animatediff}. (a) The three training stages and inference: a domain adapter (LoRA on the frozen image U-Net), the motion modules (the only weights trained on video), and MotionLoRA; at inference the motion module is attached to a personalised checkpoint. (b) One motion module: the activation is reshaped so that the $F$ frames at each spatial position form a sequence, passed through temporal self-attention, and added back to its input through a zero-initialised output layer.\relax }}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:animatediff}{{3}{5}{AnimateDiff \citep {guo2024animatediff}. (a) The three training stages and inference: a domain adapter (LoRA on the frozen image U-Net), the motion modules (the only weights trained on video), and MotionLoRA; at inference the motion module is attached to a personalised checkpoint. (b) One motion module: the activation is reshaped so that the $F$ frames at each spatial position form a sequence, passed through temporal self-attention, and added back to its input through a zero-initialised output layer.\relax }{figure.caption.3}{}}
