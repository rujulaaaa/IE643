\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Activation patching. (a) Causal tracing \citep  {meng2022rome}: a state from the clean run is restored in the corrupted run, and the recovered probability of the answer is its indirect effect (Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:ie}\unskip \@@italiccorr )}}). (b) The same idea for a video diffusion model: two generations from the same noise, whose prompts differ in one word, and an activation copied from one into the other at block $m$ over a window $W$ of denoising steps.\relax }}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:patching}{{4}{6}{Activation patching. (a) Causal tracing \citep {meng2022rome}: a state from the clean run is restored in the corrupted run, and the recovered probability of the answer is its indirect effect (Eq.~\eqref {eq:ie}). (b) The same idea for a video diffusion model: two generations from the same noise, whose prompts differ in one word, and an activation copied from one into the other at block $m$ over a window $W$ of denoising steps.\relax }{figure.caption.4}{}}
\newlabel{eq:masactrl}{{7}{6}{Literature Survey}{equation.3.7}{}}
