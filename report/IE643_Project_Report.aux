\newlabel{tab:test}{{3}{16}{Test-sweep results (12 pairs). $\dD $ is the paired gain over the prompt-only arm; the CI is a 95\% paired bootstrap of the difference in medians (10{,}000 resamples). Subject consistency stayed within 1.2\% of the source for every patch arm.\relax }{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Motion LoRAs}{16}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Motion direction on test pair 1 (``a golden retriever running'' $\to $ ``a horse walking'', beach, seed 42). Target prompt: ``a horse running''. The prompt-only horse runs, but in its own way; with the $\tilde  {x}$ patch it picks up the dog's splash and stride, and its flow similarity to A rises from 0.38 to 0.60. $D$ falls slightly on this pair because some of A's appearance comes along (the pale mane and spray).\relax }}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:qual_motion}{{10}{17}{Motion direction on test pair 1 (``a golden retriever running'' $\to $ ``a horse walking'', beach, seed 42). Target prompt: ``a horse running''. The prompt-only horse runs, but in its own way; with the $\xd $ patch it picks up the dog's splash and stride, and its flow similarity to A rises from 0.38 to 0.60. $D$ falls slightly on this pair because some of A's appearance comes along (the pale mane and spray).\relax }{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Motion LoRAs. The untrained loss differs between recipes because the cut-free validation window is the centre of the longest shot. Cut-free $\Delta D$ is scored in one pool with the test run (E10). Every $\Delta D$ CI in the table includes zero.\relax }}{17}{table.caption.15}\protected@file@percent }
\newlabel{tab:lora}{{4}{17}{Motion LoRAs. The untrained loss differs between recipes because the cut-free validation window is the centre of the longest shot. Cut-free $\dD $ is scored in one pool with the test run (E10). Every $\dD $ CI in the table includes zero.\relax }{table.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Content direction on the same pair. Target prompt: ``a golden retriever walking''. The $\bar  {x}$ patch on \texttt  {down\_blocks.3} keeps the source dog's build, coat and raised tail more closely than the prompt alone ($s_c$ to A 0.87 $\to $ 0.91) while it walks.\relax }}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:qual_content}{{11}{18}{Content direction on the same pair. Target prompt: ``a golden retriever walking''. The $\xs $ patch on \texttt {down\_blocks.3} keeps the source dog's build, coat and raised tail more closely than the prompt alone ($s_c$ to A 0.87 $\to $ 0.91) while it walks.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Held-out loss during training. Most of the drop happens in the first 100 steps for every variant, which looks more like adapting to HMDB51's look (grain, low resolution) than to its motion.\relax }}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:lora_val}{{12}{18}{Held-out loss during training. Most of the drop happens in the first 100 steps for every variant, which looks more like adapting to HMDB51's look (grain, low resolution) than to its motion.\relax }{figure.caption.16}{}}
